---
// Rendered per request so dashboard changes appear straight away.
export const prerender = false;

import Base from "../layouts/Base.astro";
import Showcase from "../components/Showcase.jsx";
import TopBar from "../components/TopBar.jsx";
import { loadGallery } from "../lib/gallery.js";

const { hero, sections, site, photos, exhibition } = await loadGallery();
---

<Base image={photos[0]?.full.src}>
  <TopBar client:load site={site} sections={sections} />
  <Showcase
    client:load
    hero={hero}
    sections={sections}
    site={site}
    exhibition={exhibition}
  />
</Base>
